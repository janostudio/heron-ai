#!/usr/bin/env node
// bin/heron - cross-platform entry script for heron-ai
// 调用当前平台的 Go 二进制，透传全部参数。
//
// 二进制来自 npm 平台包（@qinghuangniao/heron-ai-<platform>）或主包内的本地
// 构建产物，解析逻辑见 lib/resolve-binary.js。

const { spawnSync } = require('child_process');
const { resolveBinary, platformPackageName } = require('../lib/resolve-binary');

const resolved = resolveBinary();

if (!resolved.supported) {
  console.error(`Unsupported platform: ${resolved.platformKey}`);
  console.error('Supported platforms: linux/darwin x64+arm64, win32 x64');
  process.exit(1);
}

if (!resolved.binaryPath) {
  console.error(`Missing heron binary for ${resolved.platformKey}.`);
  console.error(`Expected npm platform package: ${platformPackageName(resolved.platformKey)}`);
  console.error('Reinstall with: npm install -g @qinghuangniao/heron-ai@latest');
  console.error('If you installed with --no-optional, drop that flag so the platform package is installed.');
  process.exit(1);
}

const result = spawnSync(resolved.binaryPath, process.argv.slice(2), {
  stdio: 'inherit',
});

process.exit(result.status !== null ? result.status : 1);
