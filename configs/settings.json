{
  "flow": {
    "loopMaxRounds": 0
  },
  "team": {
    "maxParallelAgents": 10,
    "maxParallelTeams": 1
  },
  "agent": {
    "loopMaxRounds": 10,
    "timeout": "120s",
    "toolMode": "parallel",
    "stream": true,
    "permissions": {
      "allow": [],
      "deny": [],
      "ask": []
    }
  },
  "tools": {
    "script": {
      "enabled": false,
      "timeout_ms": 60000,
      "max_steps": 200,
      "max_output_bytes": 102400,
      "catalog_budget": 8000
    }
  },
  "logging": {
    "level": "info",
    "output": "stdout"
  },
  "paths": {
    "data": ".agents/data/"
  }
}
